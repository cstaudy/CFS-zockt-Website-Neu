# Render runtime
NODE_ENV=production
PORT=10000

# Wird für die persistente Datenbank im nächsten Modul benötigt.
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=5

# Wird für signierte Sessions benötigt.
SESSION_SECRET=

# Optionale externe Integrationen
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Launcher / local bridge
LAUNCHER_BRIDGE_SECRET=

# PayPal – zunächst ausschließlich Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PlayStation – keine Passwörter im Projekt speichern
PSN_PROVIDER=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=
PSN_WEBHOOK_SECRET=

# Storage / Deploy
ASSET_STORAGE_PROVIDER=local
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_ENDPOINT=
RENDER_SERVICE_ID=

