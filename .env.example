# Render runtime
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Pflicht: die interne/externe PostgreSQL-URL aus Render PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DB_POOL_MAX=5

# Pflicht für Twitch-/TikTok-OAuth: verschlüsselt gespeicherte Provider-Tokens.
# Für eine bestehende Installation denselben Wert behalten, sonst sind bestehende Tokens nicht mehr lesbar.
# Die Web-Sessions selbst verwenden zufällige Tokens als SHA-256-Hash in PostgreSQL.
SESSION_SECRET=BITTE_ERSETZEN

# Optional: aktuell nur als Konfigurationsstatus erkannt.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://cfs-zockt.de/auth/twitch/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://cfs-tiktok-backend.onrender.com/api/auth/tiktok/callback
APP_BASE_URL=https://cfs-zockt.de

# Optional: aktuell nur als Konfigurationsstatus erkannt.
LAUNCHER_BRIDGE_SECRET=

# Optional: wird aktuell nur als vorhanden/nicht vorhanden erkannt.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: aktuell nur Provider + Client-ID für den Konfigurationsstatus.
PSN_PROVIDER=
PSN_CLIENT_ID=

# Optional: local ist der aktuelle Fallback. Bucket wird nur im Status geprüft.
ASSET_STORAGE_PROVIDER=local
## Optional für Render: absoluter Mount-Pfad einer Persistent Disk, z. B. /var/data/cfs-uploads
ASSET_UPLOAD_ROOT=
ASSET_STORAGE_BUCKET=

# Von Render automatisch gesetzt bzw. optional manuell überschreibbar.
APP_VERSION=
